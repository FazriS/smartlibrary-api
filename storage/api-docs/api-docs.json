                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Book"
                ],
                "summary": "Menambahkan data buku baru",
                "operationId": "47047e95a700b3271b697e57d0965191",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "author",
                                    "publish_year"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Laskar Pelangi"
                                    },
                                    "author": {
                                        "type": "string",
                                        "example": "Andrea Hirata"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Novel tentang perjuangan anak-anak Belitong."
                                    },
                                    "publish_year": {
                                        "type": "integer",
                                        "example": 2005
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Buku berhasil ditambahkan"
                    },
                    "400": {
                        "description": "Validasi gagal"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
